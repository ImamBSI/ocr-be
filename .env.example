# ==================== App Configuration ====================
PROJECT_NAME=OCR Recruitment System
DEBUG=True
API_V1_STR=/api/v1

# ==================== Database Configuration ====================
# For SQLite (development)
DATABASE_URL=sqlite:///./ocr_recruitment.db

# For PostgreSQL (production - uncomment if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/ocr_recruitment

# Database connection pool settings
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# ==================== File Upload Configuration ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ==================== OCR Configuration ====================
OCR_ENGINE=tesseract
# TESSERACT_PATH=/usr/bin/tesseract  # Set if tesseract is not in PATH
PDF_DPI=300

# ==================== Scoring Configuration ====================
MIN_SCORE_THRESHOLD=0.0
MAX_RANKED_CANDIDATES=100

# ==================== API Configuration ====================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
REQUEST_TIMEOUT=300

# ==================== Logging Configuration ====================
LOG_LEVEL=INFO

# ==================== CORS Configuration ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000