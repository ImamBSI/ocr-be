# ==================== App Configuration ====================
PROJECT_NAME=OCR Recruitment System
DEBUG=True
API_STR=/api/

# ==================== Storage Configuration ====================
# json = transaksi data pakai file JSON di app/db (tanpa database)
# sql  = pakai SQLAlchemy/SQLite (atau PostgreSQL via DATABASE_URL)
STORAGE_BACKEND=json

# ==================== Database Configuration ====================
# For SQLite (development)
DATABASE_URL=sqlite:///./ocr_recruitment.db

# For PostgreSQL (production - uncomment if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/ocr_recruitment

# Database connection pool settings
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# ==================== File Upload Configuration ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ==================== OCR Configuration ====================
OCR_ENGINE=tesseract
# TESSERACT_PATH=/usr/bin/tesseract  # Set if tesseract is not in PATH
PDF_DPI=300

# ==================== Scoring Configuration ====================
MIN_SCORE_THRESHOLD=0.0
MAX_RANKED_CANDIDATES=100

# ==================== AI / LLM Configuration ====================
# Set AI_ENABLED=true untuk mengaktifkan LLM (parsing + scoring).
# Provider: openai | gemini | ollama | azure | opencode | opencode-go | none
# OpenCode Zen (OpenAI-compatible): AI_PROVIDER=opencode, AI_MODEL=deepseek-v4.1-flash
#   Model lain yang cocok /chat/completions: deepseek-v4-flash, glm-5.3-flash,
#   minimax-m3, kimi-k2.5, mistral-large-4, atau free: big-pickle,
#   nemotron-3.5-lightning-free, space-bunny-free.
#   CATATAN: model Gemini/GPT/Claude di Zen memakai endpoint berbeda, jadi tidak
#   kompatibel dengan provider OpenAI-compatible ini.
# Google AI Studio: AI_PROVIDER=gemini, AI_MODEL=gemini-3.8-flash (opsional AI_BASE_URL)
# Ollama lokal: AI_PROVIDER=ollama, AI_BASE_URL=http://localhost:11434/v1
AI_ENABLED=true
AI_PROVIDER=opencode
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=your_opencode_zen_api_key_here
AI_BASE_URL=
AI_TEMPERATURE=0
AI_TIMEOUT=60
AI_MAX_RETRIES=3
AI_RETRY_BASE=1.0
AI_RETRY_MAX=20.0
AI_RETRY_JITTER=0.5
# rule | llm | hybrid
AI_SCORE_MODE=hybrid

# ==================== API Configuration ====================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
REQUEST_TIMEOUT=300

# ==================== Logging Configuration ====================
LOG_LEVEL=INFO

# ==================== CORS Configuration ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000